# The CSV fixtures encode their line endings on purpose: `sample.csv` and
# `bom_crlf.csv` are CRLF, `lone_cr.csv` uses a bare CR, and the parser tests
# assert that each is read correctly. Normalising them would silently delete
# what they test, so they are stored byte for byte.
crates/sp-csv/tests/fixtures/*.csv -text
sample/*.csv -text

# The embedded fonts are binary. Git detects that on its own, but a font
# whose line endings were rewritten fails to parse at run time rather than at
# check-in, so the rule is stated rather than inferred.
crates/sp-app/assets/fonts/*.ttf binary
